{
  "name": "appshots-mcp-server",
  "version": "1.0.0",
  "description": "Local MCP server that turns raw app screenshots into App Store-ready marketing images (device frames, captions, gradient backgrounds) at exact store sizes. No external API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "appshots-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
